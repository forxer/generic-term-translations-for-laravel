#!/usr/bin/env php
<?php

declare(strict_types=1);

use GenericTermTranslations\Tools\Glossary\GlossaryBuilder;
use GenericTermTranslations\Tools\Glossary\MarkdownRenderer;

require __DIR__.'/vendor/autoload.php';

$glossary = (new GlossaryBuilder(__DIR__))->build();

file_put_contents(__DIR__.'/GLOSSARY.md', (new MarkdownRenderer)->render($glossary));

printf(
    "GLOSSARY.md written: %d terms, %d domains, locales: %s.\n",
    $glossary->termCount(),
    count($glossary->domains),
    implode(', ', $glossary->locales)
);
